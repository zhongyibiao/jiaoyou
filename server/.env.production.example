# ============================================================
# jiaoyou 生产环境配置（.env）
# 复制为 .env 后填入真实值；敏感字段禁止提交到 git
# ============================================================

NODE_ENV=production
PORT=3000

# ---------- 数据库（MySQL 8.0+）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jiaoyou
DB_PASSWORD=请填入强密码
DB_NAME=jiaoyou

# ---------- JWT ----------
# ⚠️ 强随机串（≥64 字符），泄漏后立即吊销
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 或：  openssl rand -base64 48
JWT_SECRET=please-replace-with-a-strong-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# ⚠️ 必须是真实前端域名（含协议），多个用逗号分隔
# 留空将允许所有 origin，仅用于本地开发
CLIENT_ORIGIN=https://jiaoyou.example.com

# ---------- 文件上传 ----------
UPLOAD_DIR=uploads/avatars
MAX_UPLOAD_SIZE=2097152

# ---------- Socket.io（与 HTTP 同进程，端口 3000）----------
# WS 鉴权密钥与 JWT_SECRET 共用，无需单独配置
# Nginx 反代需透传 Upgrade / Connection 头（已在 jiaoyou.conf 配置）

# ============================================================
# 安全 checklist（部署前逐条确认）
# ============================================================
# [x] JWT_SECRET 已替换为强随机串（≥64 字符）
# [x] DB_PASSWORD 已替换为强密码
# [x] CLIENT_ORIGIN 已是 https 真实域名（非 localhost）
# [x] .env 文件权限 600：chmod 600 .env
# [x] .env 已加入 .gitignore
# [x] HTTPS 证书已配置（certbot）
# [x] PM2 用专用用户运行（非 root）
