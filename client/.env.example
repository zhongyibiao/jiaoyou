# 前端环境变量
# 复制为 .env.development / .env.production 分别注入

# API 基础地址（不带尾部斜杠）
VITE_API_BASE_URL=https://api.jiaoyou.example.com

# Socket.io 服务地址（与 API 同源时直接复用）
VITE_SOCKET_URL=https://api.jiaoyou.example.com

# 静态资源 CDN 域名（图片、头像）
VITE_CDN_DOMAIN=https://cdn.jiaoyou.example.com

# 地图 LBS provider
VITE_MAP_PROVIDER=amap
VITE_MAP_KEY=

# 构建模式
VITE_APP_TITLE=jiaoyou
